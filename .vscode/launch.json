{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "▶ Run app (auto)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/serve.py",
      "console": "integratedTerminal",
      "justMyCode": false,
      "jinja": true
    },
    {
      "name": "▶ Run app + refrescar datos",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/serve.py",
      "args": ["--refresh"],
      "console": "integratedTerminal",
      "jinja": true
    },
    {
      "name": "Update ANMAT (mostrar navegador)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/update_anmat.py",
      "args": ["--headed"],
      "console": "integratedTerminal"
    }
  ]
}
